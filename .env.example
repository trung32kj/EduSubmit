# Cấu hình. Copy file này thành .env rồi sửa, HOẶC đặt trực tiếp khi chạy:
#   BASE_URL=http://192.168.1.40:3000 npm start
# (Chương trình không tự đọc .env — đây là bản ghi chú các biến có thể dùng.)

# Cổng chạy web.
PORT=3000

# URL nhúng vào mã QR. Để trống thì tự lấy theo địa chỉ trình duyệt đang mở.
# Điện thoại KHÔNG mở được localhost, nên khi cho lớp quét QR phải điền IP LAN:
# BASE_URL=http://192.168.1.40:3000

# Khoá ký cookie đăng nhập. Để trống thì tự sinh và lưu vào DB.
# Đổi giá trị này sẽ đăng xuất mọi phiên đang mở.
# SESSION_SECRET=

# Trần dung lượng ảnh (MB). Đầy thì từ chối nhận thêm để không kín ổ đĩa.
MAX_TOTAL_MB=5120

# Đặt HTTPS=1 khi chạy sau HTTPS để cookie bật cờ secure.
# HTTPS=1

# Chỉ đặt khi thật sự có reverse proxy phía trước, và trỏ đúng địa chỉ proxy.
# Bật bừa sẽ cho client tự khai IP giả để lách giới hạn tần suất.
# TRUST_PROXY=loopback

# Đổi chỗ lưu dữ liệu (mặc định ./data).
# APP_DATA=./data
