# Cấu hình. Copy file này thành .env rồi sửa, HOẶC đặt trực tiếp khi chạy:
#   BASE_URL=https://baitap.example.com npm start
# (Chương trình không tự đọc .env — đây là bản ghi chú các biến có thể dùng.)

# Cổng chạy web.
PORT=3000

# --------------------------------------------------------------------------
# Cho học viên nộp bài TỪ BẤT KỲ ĐÂU (không cần cùng Wi-Fi)
# --------------------------------------------------------------------------
# Đặt BASE_URL = địa chỉ công khai mà học viên gõ được. Mã QR sẽ chứa địa chỉ này,
# và giao diện sẽ ngừng hiện gợi ý "phải cùng Wi-Fi".
# BASE_URL=https://baitap.example.com

# Bắt buộc khi có proxy/tunnel phía trước, để lấy đúng IP học viên (dùng cho giới
# hạn tần suất và dấu vết bài nộp). Giá trị = số bước proxy, thường là 1.
# KHÔNG đặt khi chạy trực tiếp: bật bừa thì client tự khai IP giả để lách giới hạn.
# TRUST_PROXY=1

# Đặt 1 khi chạy sau HTTPS để cookie bật cờ secure.
# Nếu BASE_URL đã bắt đầu bằng https:// thì tự bật, không cần biến này.
# HTTPS=1

# --------------------------------------------------------------------------

# Khoá ký cookie đăng nhập. Để trống thì tự sinh và lưu vào DB.
# Đổi giá trị này sẽ đăng xuất mọi phiên đang mở.
# SESSION_SECRET=

# Trần dung lượng ảnh (MB). Đầy thì từ chối nhận thêm để không kín ổ đĩa.
MAX_TOTAL_MB=5120

# Đổi chỗ lưu dữ liệu (mặc định ./data).
# APP_DATA=./data
